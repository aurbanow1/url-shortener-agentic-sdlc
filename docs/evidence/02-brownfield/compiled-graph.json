s":["orchestration-lead@urlshort-factory"]},"orchestrator":{"preferred_targets":["orchestration-lead@urlshort-factory"]},"integrator":{"preferred_targets":["orchestration-lead@urlshort-factory"]},"wave_reviewer":{"preferred_targets":["review-agent@urlshort-factory"]},"reviewer":{"preferred_targets":["review-agent@urlshort-factory"]},"release":{"preferred_targets":["release-agent@urlshort-factory"]}},"steps":[{"id":"decompose","actor_role":"planning","depends_on":[],"objective":"Decompose the mission intent into slices (one buildable user outcome each, disjoint file territories), record depends_on edges, the wave map and a gate tier per slice, scaffold slice.yaml files, and export the compiled graph to docs/evidence/<mission>/compiled-graph.json.","allowed_exits":["handoff","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"decomposition_review","actor_role":"reviewer","depends_on":["decompose"],"objective":"Independent review of the decomposition before the human sees it: slices are single buildable outcomes with disjoint territories, dependencies and waves are consistent with the intent, gate tiers are justified, risks are named. Rework goes back to the planner by queue handoff while this step waits; a clean review hands off.","allowed_exits":["handoff","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"mission_plan_lock","actor_role":"orchestrator","depends_on":["decomposition_review"],"objective":"Hold the decomposition at the human gate: slices, order, waves, gate tiers and risks as a decision brief. On approval record the mission plan-lock stamp on behalf of the human.","allowed_exits":["handoff","waiting","failed"],"gate":{"target":"human@kernel","summary":"Mission decomposition ready — approve slices, waves and gate tiers (mission plan-lock).","evidence_ref":"SPEC.md"},"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"wave_integration","actor_role":"integrator","dep