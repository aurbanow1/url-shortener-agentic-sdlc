ng","failed"],"gate":{"target":"human@kernel","summary":"Release candidate prepared and proven — sign off to ship (publishing stays a human act).","evidence_ref":"RELEASE.md"},"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"evidence_export","actor_role":"release","depends_on":["ship_signoff"],"objective":"Export the complete audit trail for the mission (workflow traces, queue transitions, proof readiness, compiled graph, metrics) into docs/evidence/<mission>/ and commit it.","allowed_exits":["handoff","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"mission_close","actor_role":"orchestrator","depends_on":["evidence_export"],"objective":"Close the mission: PROGRESS and NOTES current, worktrees removed, follow-on work recorded as backlog, final status to the human.","allowed_exits":["done","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600}],"exception_routing":{"default":"orchestrator","orchestrator_role":"orchestrator"},"coordination_terminal_turn_rule":"hot_potato"},"advisories":[],"unknowns":[],"exceptionReadiness":{"scope":"future-occurrences","posture":"advisory","selection":{"state":"selected","role":"orchestrator","source":"/Users/andrzej/Documents/projekty/test/openrig/url-shortener/project.yaml#lifecycle.profiles.urlshort-mission-v1.workflow.exception_routing.orchestrator_role","entryRole":"planning"},"routes":[{"exceptionClass":"unmapped_failed","state":"ready","roleResolution":"preferred-target","destinationSession":"orchestration-lead@urlshort-factory","position":"orchestrator","resolvedVia":"workflow-declared","identity":"declared-member","message":"Current evidence resolves this route; it is re-read when an occurrence is admitted."},{"exceptionClass":"stuck_overdue","state":"ready","roleResolution":"preferred-target","destinationSession":"orchestration-lead@urlshort-factory","position":"orchestrator","resolvedVia":"workflow-declared","identity":"declared-member","