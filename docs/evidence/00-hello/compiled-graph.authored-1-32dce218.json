iew hands off.","allowed_exits":["handoff","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"ship_signoff","actor_role":"release","depends_on":["release_review"],"objective":"Hold the ship decision at the human gate against RELEASE.md. Approval records delivery stamps for the mission's slices; nothing is published by an agent.","allowed_exits":["handoff","waiting","failed"],"gate":{"target":"human@kernel","summary":"Release candidate prepared and proven — sign off to ship (publishing stays a human act).","evidence_ref":"RELEASE.md"},"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"evidence_export","actor_role":"release","depends_on":["ship_signoff"],"objective":"Export the complete audit trail for the mission (workflow traces, queue transitions, proof readiness, compiled graph, metrics) into docs/evidence/<mission>/ and commit it.","allowed_exits":["handoff","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600},{"id":"mission_close","actor_role":"orchestrator","depends_on":["evidence_export"],"objective":"Close the mission: PROGRESS and NOTES current, worktrees removed, follow-on work recorded as backlog, final status to the human.","allowed_exits":["done","waiting","failed"],"re_present_after_seconds":300,"re_present_max_seconds":3600}],"exception_routing":{"default":"orchestrator","orchestrator_role":"orchestrator"},"coordination_terminal_turn_rule":"hot_potato"},"advisories":["Compilation is inspectable but ineligible for instantiation until every named unknown is resolved."],"unknowns":["opaque lifecycle operation key not supplied"],"exceptionReadiness":{"scope":"future-occurrences","posture":"advisory","selection":{"state":"selected","role":"orchestrator","source":"/Users/andrzej/Documents/projekty/test/openrig/url-shortener/project.yaml#lifecycle.profiles.urlshort-mission-v1.workflow.exception_routing.orchestrator_role","entryRole":"planning"},"routes":[{"exceptionClass":"un