%% urlshort — entity relationship diagram (kept current by the Design Agent; last: current at main ed2b940, V3 merged; V4 from the 04-audit-columns design, not yet merged)
%% No foreign key between link and audit_log by design: audit_log identifies its subject by (entity, entity_id = code)
%% and must outlive any future deletion of the subject (ADR-0008). click references link by id and goes with it (ADR-0013).
erDiagram
    LINK {
        bigint id PK "GENERATED ALWAYS AS IDENTITY"
        varchar(32) code UK "public identifier, [A-Za-z0-9]{8}, case-sensitive"
        varchar(2048) url "stored verbatim"
        timestamptz created_at "application Clock, ms; also the idempotency binding time"
        timestamptz retired_at "NULL = active; set once by DELETE"
        varchar(255) idempotency_key UK "nullable; bound by the 201 that created the row"
        timestamptz updated_at "V4 (designed): service clock; create, retire, key release"
        varchar(64) created_by "V4 (designed): anonymous"
        varchar(64) updated_by "V4 (designed): anonymous"
    }
    AUDIT_LOG {
        bigint id PK "GENERATED ALWAYS AS IDENTITY"
        timestamptz occurred_at "application Clock"
        varchar(64) actor "anonymous"
        varchar(64) action "link.create | link.retire"
        varchar(32) entity "link"
        varchar(64) entity_id "the code"
        varchar(64) request_id "X-Request-Id of the mutating request"
        varchar(4096) before_state "JSON {url,state}; NULL on create"
        varchar(4096) after_state "JSON {url,state}"
        timestamptz created_at "V4 (designed): row written, database clock"
        timestamptz updated_at "V4 (designed): equals created_at (append-only)"
        varchar(64) created_by "V4 (designed): equals actor"
        varchar(64) updated_by "V4 (designed): equals actor"
    }
    CLICK {
        bigint id PK "GENERATED ALWAYS AS IDENTITY"
        bigint link_id FK "link.id, ON DELETE CASCADE"
        timestamptz clicked_at "application Clock when the 302 was answered"
        date clicked_on "UTC day of clicked_at, computed in Java"
        varchar(2048) referrer "origin only, or NULL"
        varchar(16) user_agent_class FK "user_agent_class.token"
        varchar(64) client_hash "HMAC-SHA256 under the day's salt, hex; CHECK LENGTH = 64"
        timestamptz created_at "V3: database clock default; backfilled from clicked_at"
        timestamptz updated_at "V3: equals created_at (insert-only rows)"
        varchar(16) created_by "V3: default anonymous"
        varchar(16) updated_by "V3: default anonymous"
    }
    USER_AGENT_CLASS {
        varchar(16) token PK "browser | bot | other | unknown (seeded by V2)"
        timestamptz created_at "V3: database clock default"
        timestamptz updated_at "V3: equals created_at"
        varchar(16) created_by "V3: default system"
        varchar(16) updated_by "V3: default system"
    }
    LINK ||..o{ AUDIT_LOG : "audited by (entity_id = code, no FK)"
    LINK ||--o{ CLICK : "clicked (link_id, index with clicked_on)"
    USER_AGENT_CLASS ||--o{ CLICK : "classifies (FK, not a multi-value CHECK: H2 2.4.240)"
