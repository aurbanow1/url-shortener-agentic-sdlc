+					.as("trust for rate limiting never grants audit access").isEqualTo(403);
+			assertThat(mockMvc.perform(get("/api/audit").with(peer(P)).header("X-Forwarded-For", "127.0.0.1"))
+					.andReturn().getResponse().getStatus()).isEqualTo(403);
+		}
+	}
