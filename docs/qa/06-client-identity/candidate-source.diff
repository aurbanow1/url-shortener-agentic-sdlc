+	@Nested
+	@TestPropertySource(properties = "urlshort.rate-limit.trusted-proxies=127.0.0.1,127.0.0.2,127.255.255.254,::1,"
+			+ "0:0:0:0:0:0:0:1,::ffff:127.0.0.1,192.0.2.10,10.0.0.7,::ffff:192.0.2.10,fe80::1")
+	class TrustedAuditPeers {
+
+		@Autowired
