+							+ ";MODE=PostgreSQL;DB_CLOSE_DELAY=-1"));
+			args.addAll(List.of(settings));
+			return new SpringApplicationBuilder(UrlshortApplication.class).registerShutdownHook(false)
+					.run(args.toArray(String[]::new));
+		}
+	}
+}
