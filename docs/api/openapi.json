{
  "components" : {
    "schemas" : {
      "CreateLinkRequest" : {
        "properties" : {
          "url" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "LinkResponse" : {
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "shortUrl" : {
            "type" : "string"
          },
          "state" : {
            "type" : "string"
          },
          "url" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PingResponse" : {
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "time" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Create, read and retire short links; visitors are redirected with 302.",
    "title" : "urlshort",
    "version" : "1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/links" : {
      "post" : {
        "description" : "Without Idempotency-Key every call creates a new link. With a key, a repeat with the same url within 24 h of the first 201 returns that link (current state); a different url is 422.",
        "operationId" : "createLink",
        "parameters" : [ {
          "description" : "1 to 255 visible ASCII characters; makes a retried create return the first link",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "examples" : {
                "create" : {
                  "description" : "create",
                  "value" : {
                    "url" : "https://example.com/some/path?q=1"
                  }
                }
              },
              "schema" : {
                "$ref" : "#/components/schemas/CreateLinkRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "examples" : {
                  "created" : {
                    "description" : "created",
                    "value" : {
                      "code" : "Ab3dE9fG",
                      "createdAt" : "2026-10-03T05:12:42.133Z",
                      "shortUrl" : "http://localhost:8080/Ab3dE9fG",
                      "state" : "active",
                      "url" : "https://example.com/some/path?q=1"
                    }
                  }
                },
                "schema" : {
                  "$ref" : "#/components/schemas/LinkResponse"
                }
              }
            },
            "description" : "Created, or replayed for the same key and url",
            "headers" : {
              "Location" : {
                "description" : "/api/links/{code}",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid url or Idempotency-Key (errors[] names field and rule), or a body that is not a JSON object"
          },
          "413" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Body larger than 16 384 bytes"
          },
          "415" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Content-Type is not application/json"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Idempotency-Key already used with a different url"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Nothing was stored"
          }
        },
        "summary" : "Create a short link for an http(s) URL",
        "tags" : [ "link-controller" ]
      }
    },
    "/api/links/{code}" : {
      "delete" : {
        "operationId" : "retireLink",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Retired"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No link has this code"
          },
          "410" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Already retired"
          },
          "500" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Nothing was changed"
          }
        },
        "summary" : "Retire a link; visitors then get 410 and the record is kept",
        "tags" : [ "link-controller" ]
      },
      "get" : {
        "operationId" : "readLink",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "examples" : {
                  "link" : {
                    "description" : "link",
                    "value" : {
                      "code" : "Ab3dE9fG",
                      "createdAt" : "2026-10-03T05:12:42.133Z",
                      "shortUrl" : "http://localhost:8080/Ab3dE9fG",
                      "state" : "active",
                      "url" : "https://example.com/some/path?q=1"
                    }
                  }
                },
                "schema" : {
                  "$ref" : "#/components/schemas/LinkResponse"
                }
              }
            },
            "description" : "The link; state is active or retired"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No link has this code"
          }
        },
        "summary" : "Read a link by its code",
        "tags" : [ "link-controller" ]
      }
    },
    "/api/ping" : {
      "get" : {
        "operationId" : "ping",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PingResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "ping-controller" ]
      }
    },
    "/{code}" : {
      "get" : {
        "operationId" : "redirect",
        "parameters" : [ {
          "in" : "path",
          "name" : "code",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "302" : {
            "description" : "Redirect to the stored url, not cacheable",
            "headers" : {
              "Cache-Control" : {
                "description" : "no-store",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              },
              "Location" : {
                "description" : "The stored url, byte for byte",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "No link has this code"
          },
          "410" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "The link was retired"
          }
        },
        "summary" : "Open a short link",
        "tags" : [ "redirect-controller" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
